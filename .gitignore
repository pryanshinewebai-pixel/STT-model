# ============================================================
# STT Model — Comprehensive .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environments ---
venv/
env/
.venv/
.env/
ENV/

# --- macOS System Files ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- IDE / Editor Settings ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- Jupyter / Notebook Checkpoints ---
.ipynb_checkpoints/

# --- Heavy Model Weights & Checkpoints (Exceeds GitHub 100MB limit) ---
*.safetensors
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.h5
*.pb
*.tflite
models/
saved_models/
checkpoints/
hf_space/model/
Desktop/

# --- Large Audio & Media Files (Do not commit to Git) ---
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.webm
*.aac
*.wma
*.opus

# --- Datasets & Chunks (Thousands of generated clips) ---
data/raw/
data/processed/
data/chunked_dataset/
data/conversational_dataset/
data/*/wav_chunks/
data/*/mp3_chunks/
data/*/wav/
data/*/features/
data/*/tokenized_transcripts/
data/*/transcripts/

# --- Temporary & Output Directories ---
outputs/
temp/
tmp/
scratch/

# --- Compressed Archives ---
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.rar
*.bz2

# --- Logs & Tracking ---
logs/
*.log
runs/
wandb/
.pytest_cache/
